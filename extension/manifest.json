{
  "manifest_version": 3,
  "name": "CROT Browser Extension",
  "version": "0.1.0",
  "description": "Connects Chrome, Edge or Brave to the local CROT Host. CROT's permission engine authorizes every browser operation.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "background": {
    "service_worker": "dist/extension/src/background.js",
    "type": "module"
  },
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms", "debugger"],
  "host_permissions": ["<all_urls>"]
}
