{
  "name": "crot",
  "version": "0.1.0",
  "description": "CROT — universal local AI-agent bridge. Core, permission engine and MCP interface.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "crot-mcp": "dist/bin/crot-mcp.js",
    "crot-relay-ops": "dist/bin/crot-relay-ops.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && npm run check:docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run check:docs && npm run typecheck && npm run typecheck:extension && npm run build && npm run build:extension && npm test && npm run test:extension",
    "start": "node dist/bin/crot-mcp.js app",
    "build:extension": "node scripts/build-extension-ui.mjs && tsc -p extension/tsconfig.json",
    "typecheck:extension": "tsc -p extension/tsconfig.test.json",
    "test:extension": "vitest run --config extension/vitest.config.ts",
    "test:e2e:browser": "npm run build && npm run build:extension && vitest run --config tests-e2e/vitest.config.ts",
    "tray": "node dist/bin/crot-mcp.js app",
    "test:browser-files:native": "node scripts/browser-files-native-qualification.mjs",
    "build:release": "node scripts/build-release.mjs",
    "staging": "node scripts/staging.mjs",
    "package:extension": "npm run build:extension && node scripts/package-extension.mjs",
    "package:supply-chain": "node scripts/generate-supply-chain.mjs dist-release",
    "build:rc": "node scripts/build-rc.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "package:desktop": "node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^20.19.0",
    "electron": "44.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "koffi": "3.3.2"
  }
}
