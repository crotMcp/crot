{
  "name": "crot",
  "version": "0.1.0",
  "description": "CROT — universal local AI-agent bridge. Core, permission engine and MCP interface.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "crot-mcp": "dist/bin/crot-mcp.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:extension && npm run build && npm run build:extension && npm test && npm run test:extension",
    "start": "node dist/bin/crot-mcp.js",
    "build:extension": "tsc -p extension/tsconfig.json",
    "typecheck:extension": "tsc -p extension/tsconfig.test.json",
    "test:extension": "vitest run --config extension/vitest.config.ts",
    "test:e2e:browser": "npm run build && npm run build:extension && vitest run --config tests-e2e/vitest.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "koffi": "3.3.2"
  }
}
