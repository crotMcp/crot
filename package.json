{
  "name": "crot",
  "version": "0.1.0",
  "description": "CROT — universal local AI-agent bridge. Core, permission engine and MCP interface.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "crot-mcp": "dist/bin/crot-mcp.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "start": "node dist/bin/crot-mcp.js",
    "build:extension": "tsc -p extension/tsconfig.json",
    "typecheck:extension": "tsc -p extension/tsconfig.test.json",
    "test:extension": "vitest run --config extension/vitest.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "koffi": "3.3.2"
  }
}
